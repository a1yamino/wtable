# Default deny. Add new source directories and asset types explicitly.
*

# Repository files.
!/.gitignore
!/Makefile
!/README.md
!/README.zh-CN.md
!/AGENTS.md
!/CLAUDE.md
!/go.mod
!/go.sum
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

# Go source (including *_test.go); generated binaries remain ignored.
!/cmd/
!/cmd/wtable/
!/cmd/wtable/*.go
!/internal/
!/internal/agent/
!/internal/agent/*.go
!/internal/config/
!/internal/config/*.go
!/internal/model/
!/internal/model/*.go
!/internal/rpc/
!/internal/rpc/*.go
!/internal/server/
!/internal/server/*.go
!/internal/store/
!/internal/store/*.go
!/internal/terminal/
!/internal/terminal/*.go
!/internal/tui/
!/internal/tui/*.go
!/internal/daemon/
!/internal/daemon/*.go

# Wails desktop prototype.
!/desktop/
!/desktop/**
/desktop/frontend/node_modules/
/desktop/frontend/wailsjs/
/desktop/frontend/package.json.md5
/desktop/frontend/dist/*
!/desktop/frontend/dist/.gitkeep
/desktop/build/bin/

# Maintained scripts.
!/scripts/
!/scripts/*.py
!/scripts/*.sh
!/scripts/fixtures/
!/scripts/fixtures/*.py
